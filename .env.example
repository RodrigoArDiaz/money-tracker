APP_NAME="Money Tracker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=money_tracker
DB_USERNAME=money_tracker
DB_PASSWORD=secret

# Solo docker-compose: puerto en el host donde se expone Postgres (internamente sigue siendo 5432 entre contenedores).
# Por defecto 5433 para no chocar con otro Postgres local en 5432.
# DB_PORT_HOST=5433

# pgAdmin — http://localhost:5050 — Email/contraseña: PGADMIN_DEFAULT_EMAIL / PGADMIN_DEFAULT_PASSWORD (por defecto admin@local.test / admin).
# Registrar servidor: Host name/internet address = postgres, Port = 5432, Maintenance DB = postgres, Username/Password = DB_USERNAME / DB_PASSWORD.
# PGADMIN_PORT=5050
# PGADMIN_DEFAULT_EMAIL=admin@local.test
# PGADMIN_DEFAULT_PASSWORD=admin

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Con docker compose del proyecto: MAIL_HOST=mailpit (red interna). UI del Mailpit del proyecto: http://localhost:8026 (SMTP interno 1025; en el host suele mapearse 1026→1025).
# Si usás otro Mailpit ya en 8025/1025 del host, en .env del contenedor app podés usar MAIL_HOST=host.docker.internal y MAIL_PORT=1025 (requiere extra_hosts en compose).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Puertos opcionales de Mailpit (docker-compose)
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

INERTIA_SSR_ENABLED=false

# Laravel Socialite (ejemplo Google; añade más proveedores en config/services.php)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
